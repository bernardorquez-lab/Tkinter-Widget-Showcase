import tkinter as tk

root = tk.Tk() 
root.geometry("1200x750")

top_frame = tk.Frame(root, bg="violet", relief="sunken", borderwidth=10 ) 
top_frame.pack(side="bottom", fill="x")

label = tk.Label(top_frame, text="This is a Frame!", bg="blue", font=("Arial", 24)) 
label.pack(side='left',padx=10, pady=10)

label2 = tk.Label(top_frame, text="This is another Label!", bg="red", font=("Arial", 24))
label2.pack(side='left',padx=10, pady=10)

root.mainloop()
